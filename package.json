  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false && vite build",
    "preview": "vite preview --host",
