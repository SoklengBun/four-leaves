    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.104.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11",
